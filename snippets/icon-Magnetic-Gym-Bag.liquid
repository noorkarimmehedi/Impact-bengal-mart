<style>
  :root {
    --gradient: linear-gradient(90deg, #09184c 0%, #2c4ff0 100%);
    --color-start: #09184c;
    --color-end: #2c4ff0;
    --color-border: #111111;
    --color-text: #111111;
  }

  .trust-badges-bar {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    padding: 0;
    margin: 16px 0 0 0;
    width: 100%;
    box-sizing: border-box;
  }

  .review-badge-bar {
    border-top: none;
    margin-top: 0;
    margin-bottom: 16px;
  }

  .trust-badges-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    justify-content: center;
    padding: 18px 20px;
  }

  .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-badge-icon svg {
    width: 34px;
    height: 34px;
  }

  .trust-badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
    text-align: center;
  }

  .trust-badge-line1 {
    font-size: 12px;
    color: var(--color-text);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .trust-badge-line2 {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* Gradient text */
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .trust-badge-divider {
    width: 1px;
    background-color: var(--color-border);
    flex-shrink: 0;
    align-self: stretch;
  }

  /* kaching-bundles overrides */
  .kaching-bundles .kaching-bundles__bar-label {
    background: var(--gradient) !important;
    color: white !important;
    border-radius: 8px !important;
  }

  .kaching-bundles .kaching-bundles__bar-most-popular__content {
    background: var(--gradient) !important;
  }

  @media (max-width: 480px) {
    .trust-badge-item {
      padding: 14px 12px;
      gap: 10px;
    }

    .trust-badge-icon svg {
      width: 26px;
      height: 26px;
    }

    .trust-badge-line1 {
      font-size: 11px;
    }
  }
</style>

