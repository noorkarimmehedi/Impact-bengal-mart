{% comment %}
  Live Order Counter Snippet — Swiss Grid / One Line v2
  Usage: {% render 'live-order-counter' %}
{% endcomment %}

<div class="loc" aria-live="polite">
  <span class="loc__dot"></span>
  <span class="loc__time"><span id="loc-m">10</span>:<span id="loc-s">00</span></span>
  <span class="loc__label">to ship today</span>
  <span class="loc__line"></span>
  <span class="loc__cta">ORDER NOW</span>
</div>

<style>
  .loc {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 14px;
    border-left: 3px solid #111;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: #fafafa;
    width: 100%;
    box-sizing: border-box;
  }

  .loc__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e63329;
    flex-shrink: 0;
    animation: loc-blink 1s ease-in-out infinite;
  }

  .loc__time {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #111;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .loc__label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: #999;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .loc__line {
    flex: 1;
    height: 1px;
    background: #e0e0e0;
    min-width: 12px;
  }

  .loc__cta {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: #111;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  @keyframes loc-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.15; }
  }
</style>

<script>
  (function () {
    var m = document.getElementById('loc-m');
    var s = document.getElementById('loc-s');
    if (!m || !s) return;
    var t = 10 * 60;
    function tick() {
      if (t <= 0) t = 10 * 60;
      var mm = Math.floor(t / 60), ss = t % 60;
      m.textContent = mm < 10 ? '0' + mm : mm;
      s.textContent = ss < 10 ? '0' + ss : ss;
      t--;
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
