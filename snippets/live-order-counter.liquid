{% comment %}
  Live Order Counter Snippet — Swiss Grid / One Line
  Usage: {% render 'live-order-counter' %}
{% endcomment %}

<div class="loc" aria-live="polite">
  <span class="loc__tag">SHIPS TODAY</span>
  <span class="loc__rule"></span>
  <span class="loc__label">Order within</span>
  <span class="loc__time"><span id="loc-m">10</span>:<span id="loc-s">00</span></span>
  <span class="loc__dot"></span>
</div>

<style>
  .loc {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 36px;
    padding: 0 16px;
    border-top: 1.5px solid #111;
    border-bottom: 1.5px solid #111;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: #fff;
    width: 100%;
    box-sizing: border-box;
  }

  .loc__tag {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #fff;
    background: #111;
    padding: 3px 7px;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .loc__rule {
    display: block;
    width: 1.5px;
    height: 16px;
    background: #d1d1d1;
    flex-shrink: 0;
  }

  .loc__label {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: #888;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .loc__time {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #111;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .loc__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e63329;
    flex-shrink: 0;
    animation: loc-blink 1.2s ease-in-out infinite;
  }

  @keyframes loc-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.2; }
  }
</style>

<script>
  (function () {
    var m = document.getElementById('loc-m');
    var s = document.getElementById('loc-s');
    if (!m || !s) return;
    var t = 10 * 60;
    function tick() {
      if (t <= 0) t = 10 * 60;
      var mm = Math.floor(t / 60), ss = t % 60;
      m.textContent = mm < 10 ? '0' + mm : mm;
      s.textContent = ss < 10 ? '0' + ss : ss;
      t--;
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
