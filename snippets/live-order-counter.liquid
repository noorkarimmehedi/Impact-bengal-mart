{% comment %}
  Live Order Counter Snippet — Swiss Grid / One Line v3
  Usage: {% render 'live-order-counter' %}
{% endcomment %}

<div class="loc" aria-live="polite">
  <span class="loc__dot"></span>
  <span class="loc__text">Order in <strong class="loc__time"><span id="loc-m">10</span>:<span id="loc-s">00</span></strong> to ship today</span>
</div>

<style>
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 0;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid #e8e8e8;
  }

  .loc__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e63329;
    flex-shrink: 0;
    animation: loc-blink 1.2s ease-in-out infinite;
  }

  .loc__text {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: #888;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .loc__time {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #111;
    font-variant-numeric: tabular-nums;
  }

  @keyframes loc-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.15; }
  }
</style>

<script>
  (function () {
    var m = document.getElementById('loc-m');
    var s = document.getElementById('loc-s');
    if (!m || !s) return;
    var t = 10 * 60;
    function tick() {
      if (t <= 0) t = 10 * 60;
      var mm = Math.floor(t / 60), ss = t % 60;
      m.textContent = mm < 10 ? '0' + mm : mm;
      s.textContent = ss < 10 ? '0' + ss : ss;
      t--;
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
