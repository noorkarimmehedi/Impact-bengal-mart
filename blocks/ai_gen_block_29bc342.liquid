{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-slider-{{ ai_gen_id }} {
    display: block;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: {{ block.settings.background_color }};
    box-sizing: border-box;
  }

  .ai-category-slider-container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }

  .ai-category-slider-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 28px;
  }

  .ai-category-slider-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .ai-category-slider-subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-category-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-category-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-category-slider-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-category-slider-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.card_size }}px;
    scroll-snap-align: start;
  }

  .ai-category-slider-link-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    align-items: center;
  }

  .ai-category-slider-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.text_spacing }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    border-radius: 50%;
    border: 1px solid {{ block.settings.card_border_color }};
    padding: 12px;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-category-slider-link-{{ ai_gen_id }}:hover .ai-category-slider-image-wrapper-{{ ai_gen_id }} {
    border-color: {{ block.settings.hover_border_color }};
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .ai-category-slider-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .ai-category-slider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-slider-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-slider-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font }};
    font-size: {{ block.settings.category_name_size }}px;
    color: {{ block.settings.category_name_color }};
    font-weight: 500;
    text-align: center;
    margin: auto 0 0;
    line-height: 1.3;
  }

  .ai-category-slider-pagination-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 28px;
  }

  .ai-category-slider-nav-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: {{ block.settings.nav_icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .ai-category-slider-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-category-slider-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.counter_size }}px;
    color: {{ block.settings.counter_color }};
    font-weight: 500;
    min-width: 48px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-category-slider-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.6 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-category-slider-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-category-slider-item-{{ ai_gen_id }} {
      width: {{ block.settings.card_size | times: 0.8 }}px;
    }

    .ai-category-slider-header-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .ai-category-slider-pagination-{{ ai_gen_id }} {
      margin-top: 20px;
    }
  }
{% endstyle %}

<category-slider-{{ ai_gen_id }} class="ai-category-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="page-width">
  <div class="ai-category-slider-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-category-slider-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-category-slider-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-category-slider-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-category-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-category-slider-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]
            assign custom_image_key = 'custom_image_' | append: i
            assign custom_image = block.settings[custom_image_key]
          %}

          {% if collection != blank %}
            <div class="ai-category-slider-item-{{ ai_gen_id }}">
              <a href="{{ collection.url }}" class="ai-category-slider-link-{{ ai_gen_id }}">
                <div class="ai-category-slider-image-wrapper-{{ ai_gen_id }}">
                  {% if custom_image != blank %}
                    <img
                      src="{{ custom_image | image_url: width: 400 }}"
                      alt="{{ custom_image.alt | escape }}"
                      class="ai-category-slider-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {% elsif collection.image %}
                    <img
                      src="{{ collection.image | image_url: width: 400 }}"
                      alt="{{ collection.image.alt | escape }}"
                      class="ai-category-slider-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {% elsif collection.products.first and collection.products.first.featured_image %}
                    <img
                      src="{{ collection.products.first.featured_image | image_url: width: 400 }}"
                      alt="{{ collection.products.first.featured_image.alt | escape }}"
                      class="ai-category-slider-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {% else %}
                    <div class="ai-category-slider-placeholder-{{ ai_gen_id }}">
                      {{ 'collection-apparel-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <h3 class="ai-category-slider-name-{{ ai_gen_id }}">{{ collection.title }}</h3>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.show_navigation %}
        <div class="ai-category-slider-pagination-{{ ai_gen_id }}">
          <button
            class="ai-category-slider-nav-{{ ai_gen_id }} ai-category-slider-nav-prev-{{ ai_gen_id }}"
            aria-label="Previous categories"
            data-direction="prev"
          >
            <svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="12 4 6 10 12 16"></polyline>
            </svg>
          </button>
          <span class="ai-category-slider-count-{{ ai_gen_id }}" aria-live="polite">1 / 1</span>
          <button
            class="ai-category-slider-nav-{{ ai_gen_id }} ai-category-slider-nav-next-{{ ai_gen_id }}"
            aria-label="Next categories"
            data-direction="next"
          >
            <svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="8 4 14 10 8 16"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>
  </div>
</category-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CategorySlider{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-category-slider-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-category-slider-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-category-slider-nav-next-{{ ai_gen_id }}');
        this.counter = this.querySelector('.ai-category-slider-count-{{ ai_gen_id }}');

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.scroll('prev'));
          this.nextButton.addEventListener('click', () => this.scroll('next'));
          this.track.addEventListener('scroll', () => this.update());
          window.addEventListener('resize', () => this.update());
          this.update();
        }
      }

      pageCount() {
        return Math.max(1, Math.ceil(this.track.scrollWidth / this.track.offsetWidth));
      }

      currentPage() {
        const maxScroll = this.track.scrollWidth - this.track.offsetWidth;
        if (maxScroll <= 0) return 1;
        return Math.min(
          this.pageCount(),
          Math.round((this.track.scrollLeft / maxScroll) * (this.pageCount() - 1)) + 1
        );
      }

      scroll(direction) {
        const amount = this.track.offsetWidth;
        this.track.scrollLeft += direction === 'next' ? amount : -amount;
      }

      update() {
        const maxScroll = this.track.scrollWidth - this.track.offsetWidth;
        this.prevButton.disabled = this.track.scrollLeft <= 0;
        this.nextButton.disabled = this.track.scrollLeft >= maxScroll - 1;
        if (this.counter) {
          this.counter.textContent = this.currentPage() + ' / ' + this.pageCount();
        }
      }
    }

    customElements.define('category-slider-{{ ai_gen_id }}', CategorySlider{{ ai_gen_id }});
  })();
</script>

