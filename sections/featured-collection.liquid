{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --best-sellers-bg: {{ section.settings.background | default: settings.background | default: '#ffffff' }};
    --best-sellers-card-bg: {{ section.settings.product_card_background | default: '#ffffff' }};
    --best-sellers-text: {{ section.settings.text_color | default: settings.text_color | default: '#1a1a1a' }};
    --best-sellers-accent: {{ section.settings.accent_color | default: '#7900FD' }};
    --best-sellers-border: #e8e8e8;
    --best-sellers-radius: {{ section.settings.card_corner_radius | default: 12 }}px;
    --best-sellers-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --best-sellers-heading-weight: {{ section.settings.heading_font.weight }};
    --best-sellers-heading-style: {{ section.settings.heading_font.style }};
    --best-sellers-mobile-gap: {{ section.settings.mobile_card_gap | default: 8 }}px;
  }

  #shopify-section-{{ section.id }} .best-sellers {
    padding: 40px 16px;
    background: var(--best-sellers-bg);
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .best-sellers {
      padding: 20px 16px;
    }
  }

  .best-sellers__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 32px;
  }

  .best-sellers__title {
    font-size: 32px;
    font-family: var(--best-sellers-heading-font);
    font-weight: var(--best-sellers-heading-weight);
    font-style: var(--best-sellers-heading-style);
    line-height: 1.2;
    color: var(--best-sellers-text);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .best-sellers__link {
    font-size: 15px;
    font-weight: 400;
    color: var(--best-sellers-text);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: currentColor;
    text-decoration-line: underline;
    white-space: nowrap;
  }

  .best-sellers__carousel-wrap {
    position: relative;
    overflow: hidden;
  }

  .best-sellers__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 0 8px;
  }

  @media (max-width: 699px) {
    .best-sellers__track {
      gap: var(--best-sellers-mobile-gap);
    }
  }

  .best-sellers__track::-webkit-scrollbar {
    display: none;
  }

  .best-sellers__slide {
    flex: 0 0 calc(25% - 15px);
    min-width: 0;
    scroll-snap-align: start;
  }

  @media (max-width: 999px) {
    .best-sellers__slide {
      flex: 0 0 calc(50% - 10px);
    }
    .best-sellers__title {
      font-size: 22px;
    }
  }

  @media (max-width: 699px) {
    .best-sellers__slide {
      flex: 0 0 calc(50% - var(--best-sellers-mobile-gap) / 2);
    }
  }

  .best-sellers__card {
    background: var(--best-sellers-card-bg);
    border: 1px solid var(--best-sellers-border);
    border-radius: var(--best-sellers-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .best-sellers__image-wrap {
    position: relative;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .best-sellers__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .best-sellers__badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #b64236;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 10px 18px;
    border-radius: 10px;
    line-height: 1;
  }

  .best-sellers__body {
    padding: 0 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .best-sellers__rating {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .best-sellers__rating-stars {
    display: flex;
    gap: 2px;
    color: #1a1a1a;
  }

  .best-sellers__rating-stars svg {
    width: 18px;
    height: 18px;
  }

  .best-sellers__rating-stars .star-filled {
    fill: currentColor;
    color: inherit;
  }

  .best-sellers__rating-stars .star-empty {
    fill: none;
    color: #ddd;
    stroke: #ddd;
    stroke-width: 1.5;
  }

  .best-sellers__rating-count {
    font-size: 12px;
    color: #888;
  }

  .best-sellers__product-title {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--best-sellers-text);
    margin: 0;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .best-sellers__product-title a {
    color: inherit;
    text-decoration: none;
  }

  .best-sellers__desc {
    font-size: 15px;
    color: #6a6a6a;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .best-sellers__prices {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .best-sellers__price {
    font-size: 16px;
    font-weight: 400;
    color: var(--best-sellers-text);
  }

  .best-sellers__compare-price {
    font-size: 15px;
    color: #a0a0a0;
    text-decoration: line-through;
  }

  .best-sellers__buy-btn {
    display: block;
    width: 100%;
    padding: 14px 20px;
    margin-top: auto;
    border: 1.5px solid var(--best-sellers-text);
    border-radius: 999px;
    background: transparent;
    color: var(--best-sellers-text);
    font-size: 16px;
    font-weight: 500;
    text-align: center;
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
  }

  .best-sellers__buy-btn--sold-out {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .best-sellers__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 28px;
    padding-top: 20px;
  }

  .best-sellers__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--best-sellers-border);
    border-radius: 50%;
    background: var(--best-sellers-card-bg);
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--best-sellers-text);
  }

  .best-sellers__nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .best-sellers__nav-btn svg {
    width: 18px;
    height: 18px;
  }

  .best-sellers__pagination {
    font-size: 14px;
    font-weight: 500;
    color: #888;
    min-width: 48px;
    text-align: center;
    letter-spacing: 0.3px;
  }

  @media (max-width: 699px) {
    .best-sellers__nav-btn {
      width: 36px;
      height: 36px;
    }
    .best-sellers__nav-btn svg {
      width: 14px;
      height: 14px;
    }
    .best-sellers__product-title {
      font-size: 14px;
    }
    .best-sellers__price {
      font-size: 14px;
    }
    .best-sellers__buy-btn {
      font-size: 12px;
      padding: 8px 12px;
    }

    /* Hide review stars on mobile */
    .best-sellers__rating {
      display: none;
    }

    /* Switch from horizontal scroll carousel to 2-column grid on mobile */
    .best-sellers__track {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--best-sellers-mobile-gap);
      overflow-x: visible;
      scroll-snap-type: none;
      padding: 4px 0 8px;
    }

    .best-sellers__slide {
      flex: none;
      width: 100%;
      min-width: 0;
      scroll-snap-align: none;
    }

    /* Hide navigation arrows on mobile since we use grid */
    .best-sellers__nav {
      display: none;
    }
  }
</style>

{%- assign products = section.settings.products | default: section.settings.collection.products -%}
{%- assign product_count = products | length -%}
{%- assign link_url = section.settings.link_url | default: section.settings.collection.url -%}

<div class="best-sellers">
  <div class="{% if section.settings.full_width %}page-width{% else %}container{% endif %}">
    <div class="best-sellers__header">
      <h2 class="best-sellers__title">{{ section.settings.title | default: 'Best Sellers' }}</h2>
      {%- if link_url != blank -%}
        <a href="{{ link_url }}" class="best-sellers__link">{{ section.settings.link_text | default: 'View all products' }}</a>
      {%- endif -%}
    </div>

    <div class="best-sellers__carousel-wrap">
      <div class="best-sellers__track" id="best-sellers-track-{{ section.id }}">
        {%- for product in products limit: section.settings.products_count -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          {%- assign is_on_sale = false -%}
          {%- if variant.compare_at_price > variant.price -%}
            {%- assign is_on_sale = true -%}
          {%- endif -%}

          <div class="best-sellers__slide">
            <div class="best-sellers__card">
              <div class="best-sellers__image-wrap">
                <a href="{{ product.url }}" data-instant>
                  {%- if product.featured_media -%}
                    {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,400,500,600' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                {%- if is_on_sale -%}
                  <span class="best-sellers__badge">ON SALE</span>
                {%- endif -%}
              </div>

              <div class="best-sellers__body">
                {%- assign rating_value = product.metafields.reviews.rating.value.rating | default: 0 | plus: 0 -%}
                {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0 -%}

                <div class="best-sellers__prices">
                  {%- assign price_prefix = '' -%}
                  {%- if product.price_varies -%}
                    {%- assign price_prefix = 'From ' -%}
                  {%- endif -%}
                  <span class="best-sellers__price">
                    {{ price_prefix }}৳{{ variant.price | money_without_currency }}
                  </span>
                  {%- if is_on_sale -%}
                    <span class="best-sellers__compare-price">
                      ৳{{ variant.compare_at_price | money_without_currency }}
                    </span>
                  {%- endif -%}
                </div>

                <h3 class="best-sellers__product-title">
                  <a href="{{ product.url }}" data-instant>{{ product.title }}</a>
                </h3>

                {%- if rating_value > 0 -%}
                  <div class="best-sellers__rating">
                    <div class="best-sellers__rating-stars">
                      {%- for i in (1..5) -%}
                        {%- if i <= rating_value -%}
                          <svg viewBox="0 0 20 20" class="star-filled">
                            <path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z" fill="currentColor"/>
                          </svg>
                        {%- else -%}
                          <svg viewBox="0 0 20 20" class="star-empty">
                            <path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z" fill="currentColor"/>
                          </svg>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}

                {%- if product.description != blank -%}
                  <p class="best-sellers__desc">{{ product.description | strip_html | truncatewords: 20 }}</p>
                {%- endif -%}

                {%- if product.available -%}
                  {%- if product.variants.size == 1 -%}
                    {%- form 'product', product, is: 'product-form' -%}
                      <input type="hidden" name="id" value="{{ variant.id }}">
                      <button type="submit" class="best-sellers__buy-btn">Buy Now</button>
                    {%- endform -%}
                  {%- else -%}
                    <a href="{{ product.url }}" class="best-sellers__buy-btn" style="text-decoration:none;">Buy Now</a>
                  {%- endif -%}
                {%- else -%}
                  <button class="best-sellers__buy-btn best-sellers__buy-btn--sold-out" disabled>Sold Out</button>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          {%- for i in (1..section.settings.products_count) -%}
            {%- capture placeholder_image -%}product-{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
            <div class="best-sellers__slide">
              <div class="best-sellers__card">
                <div class="best-sellers__image-wrap">
                  {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="best-sellers__body">
                  <div class="best-sellers__rating">
                    <div class="best-sellers__rating-stars">
                      {%- for i in (1..5) -%}
                        <svg viewBox="0 0 20 20" class="star-filled">
                          <path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z" fill="currentColor"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                    <span class="best-sellers__rating-count">(2)</span>
                  </div>
                  <h3 class="best-sellers__product-title">{{ 'product.title' | t | default: 'Product Title' }}</h3>
                  <p class="best-sellers__desc">Short product description goes here</p>
                  <div class="best-sellers__prices">
                    <span class="best-sellers__price">৳99</span>
                    <span class="best-sellers__compare-price">৳149</span>
                  </div>
                  <button class="best-sellers__buy-btn">Buy Now</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <nav class="best-sellers__nav">
      <button class="best-sellers__nav-btn" id="best-sellers-prev-{{ section.id }}" aria-label="Previous">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="12 5 7 10 12 15"/>
        </svg>
      </button>
      <span class="best-sellers__pagination" id="best-sellers-page-{{ section.id }}">1 / 1</span>
      <button class="best-sellers__nav-btn" id="best-sellers-next-{{ section.id }}" aria-label="Next">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="8 5 13 10 8 15"/>
        </svg>
      </button>
    </nav>
  </div>
</div>

<script>
  (function() {
    const track = document.getElementById('best-sellers-track-{{ section.id }}');
    const prevBtn = document.getElementById('best-sellers-prev-{{ section.id }}');
    const nextBtn = document.getElementById('best-sellers-next-{{ section.id }}');
    const pageEl = document.getElementById('best-sellers-page-{{ section.id }}');

    if (!track || !prevBtn || !nextBtn || !pageEl) return;

    const perPage = {{ section.settings.products_per_row_desktop | default: 4 }};
    const slides = track.children;
    const totalSlides = slides.length;
    const totalPages = Math.ceil(totalSlides / perPage);

    function getVisibleCount() {
      if (window.innerWidth <= 999) return 2;
      return {{ section.settings.products_per_row_desktop | default: 4 }};
    }

    function updatePagination() {
      const visible = getVisibleCount();
      const pages = Math.ceil(totalSlides / visible);
      const scrollLeft = track.scrollLeft;
      const slideWidth = slides[0]?.offsetWidth + 20 || 0;
      const currentPage = Math.min(Math.floor(scrollLeft / (slideWidth * visible)) + 1, pages);
      pageEl.textContent = currentPage + ' / ' + pages;

      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= pages;
    }

    function scrollToPage(page) {
      const visible = getVisibleCount();
      const slideWidth = slides[0]?.offsetWidth + 20 || 0;
      const target = (page - 1) * slideWidth * visible;
      track.scrollTo({ left: target, behavior: 'smooth' });
    }

    prevBtn.addEventListener('click', function() {
      const visible = getVisibleCount();
      const pages = Math.ceil(totalSlides / visible);
      const scrollLeft = track.scrollLeft;
      const slideWidth = slides[0]?.offsetWidth + 20 || 0;
      const currentPage = Math.min(Math.floor(scrollLeft / (slideWidth * visible)) + 1, pages);
      if (currentPage > 1) scrollToPage(currentPage - 1);
    });

    nextBtn.addEventListener('click', function() {
      const visible = getVisibleCount();
      const pages = Math.ceil(totalSlides / visible);
      const scrollLeft = track.scrollLeft;
      const slideWidth = slides[0]?.offsetWidth + 20 || 0;
      const currentPage = Math.min(Math.floor(scrollLeft / (slideWidth * visible)) + 1, pages);
      if (currentPage < pages) scrollToPage(currentPage + 1);
    });

    let ticking = false;
    track.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          updatePagination();
          ticking = false;
        });
        ticking = true;
      }
    });

    window.addEventListener('resize', updatePagination);
    updatePagination();
  })();
</script>

{% schema %}
{
  "name": "Best Sellers",
  "class": "shopify-section--featured-collection",
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "Replaces collection when selected."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 50,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 5,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "info": "Default to collection URL."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "View all products"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_card_gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile card gap",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (button hover)"
    },
    {
      "type": "color",
      "id": "product_card_background",
      "label": "Product card background"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}
